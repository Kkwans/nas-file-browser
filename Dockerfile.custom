# ============================================================
# NAS File Browser - Custom Build (Multi-stage)
# ============================================================

# --- Stage 1: Build Frontend ---
FROM node:24-alpine AS frontend-builder

WORKDIR /src/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml ./

RUN corepack enable && \
    corepack prepare pnpm@10.33.4 --activate && \
    pnpm install --frozen-lockfile

COPY frontend/ ./

RUN pnpm build

# --- Stage 2: Build Backend ---
FROM golang:1.25-alpine AS backend-builder

RUN apk add --no-cache git

ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

COPY frontend/assets.go ./frontend/assets.go

COPY --from=frontend-builder /src/frontend/dist/ ./frontend/dist/

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o filebrowser .

# Download JSON.sh in builder (has network access)
RUN wget -q -O /JSON.sh https://raw.githubusercontent.com/dominictarr/JSON.sh/0d5e5c77365f63809bf6e77ef44a1f34b0e05840/JSON.sh

# --- Stage 3: Runtime ---
FROM alpine:3.21

RUN apk add --no-cache ca-certificates mailcap tini

COPY --from=backend-builder /src/filebrowser /usr/local/bin/filebrowser
COPY --from=backend-builder /src/docker/common/ /
COPY --from=backend-builder /src/docker/alpine/ /
COPY --from=backend-builder /JSON.sh /JSON.sh
RUN chmod +x /healthcheck.sh /init.sh /JSON.sh

RUN mkdir -p /config /database /srv

VOLUME /config /database

EXPOSE 80

HEALTHCHECK --start-period=2s --interval=5s --timeout=3s CMD /healthcheck.sh

ENTRYPOINT ["tini", "--", "/init.sh"]
